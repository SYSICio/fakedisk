#include <windows.h>
#include "resource.h"

IDI_MAIN ICON "icon.ico"

IDR_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开磁盘(&O)...", IDM_OPEN
        MENUITEM "新建磁盘(&N)...", IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "导入文件(&I)...", IDM_IMPORT_FILES
        MENUITEM "导入文件夹(&D)...", IDM_IMPORT_FOLDER
        MENUITEM "导出(&E)...", IDM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "关闭磁盘(&C)", IDM_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)", IDM_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "新建文件夹(&W)", IDM_NEWFOLDER
        MENUITEM "重命名(&R)\tF2", IDM_RENAME
        MENUITEM "删除(&D)\tDel", IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "属性(&P)...", IDM_PROP
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "校验完整性(&K)", IDM_FSCK
        MENUITEM "整理数据区(&G)", IDM_DEFRAG
        MENUITEM SEPARATOR
        MENUITEM "打开/运行选中项(&U)", IDM_RUN
    END
    POPUP "视图(&V)"
    BEGIN
        MENUITEM "桌面视图(&D)", IDM_VIEW_DESKTOP
        MENUITEM "列表视图(&L)", IDM_VIEW_LIST
    END
    POPUP "语言(&L)"
    BEGIN
        MENUITEM "中文", IDM_LANG_ZH
        MENUITEM "English", IDM_LANG_EN
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A)", IDM_ABOUT
    END
END

IDD_NEW DIALOGEX 0, 0, 262, 114
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建 fakedisk 磁盘"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "磁盘文件:", IDC_NEW_FILE_LABEL, 10, 12, 60, 10
    EDITTEXT IDC_NEW_PATH, 10, 24, 178, 14, ES_AUTOHSCROLL
    PUSHBUTTON "浏览...", IDC_NEW_BROWSE, 194, 23, 58, 14
    LTEXT "容量:", IDC_NEW_CAP_LABEL, 10, 48, 40, 10
    COMBOBOX IDC_NEW_CAP, 10, 60, 74, 120, CBS_DROPDOWN | WS_VSCROLL
    LTEXT "卷标:", IDC_NEW_LABEL_LABEL, 96, 62, 36, 10
    EDITTEXT IDC_NEW_LABEL, 126, 60, 126, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "确定", IDOK, 142, 92, 54, 14
    PUSHBUTTON "取消", IDCANCEL, 202, 92, 50, 14
END

IDD_PROP DIALOGEX 0, 0, 284, 212
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "属性"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称:", IDC_PROP_NAME_LABEL, 10, 12, 40, 10
    LTEXT "", IDC_PROP_NAME, 56, 12, 218, 10
    LTEXT "类型:", IDC_PROP_TYPE_LABEL, 10, 28, 40, 10
    LTEXT "", IDC_PROP_TYPE, 56, 28, 218, 10
    LTEXT "大小:", IDC_PROP_SIZE_LABEL, 10, 44, 40, 10
    LTEXT "", IDC_PROP_SIZE, 56, 44, 218, 10
    LTEXT "", IDC_PROP_TIME, 10, 62, 264, 26
    GROUPBOX "属性", IDC_PROP_ATTR_GROUP, 10, 96, 264, 44
    AUTOCHECKBOX "只读(&R)", IDC_PROP_RO, 22, 110, 58, 12
    AUTOCHECKBOX "隐藏(&H)", IDC_PROP_H, 92, 110, 58, 12
    AUTOCHECKBOX "系统(&S)", IDC_PROP_S, 162, 110, 58, 12
    AUTOCHECKBOX "存档(&A)", IDC_PROP_A, 222, 110, 48, 12
    LTEXT "卷标:", IDC_PROP_LABEL_LABEL, 10, 152, 40, 10
    EDITTEXT IDC_PROP_LABEL, 56, 150, 150, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "确定", IDOK, 160, 190, 54, 14
    PUSHBUTTON "取消", IDCANCEL, 220, 190, 50, 14
END

IDD_INPUT DIALOGEX 0, 0, 246, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "", IDC_INPUT_PROMPT, 10, 12, 226, 10
    EDITTEXT IDC_INPUT_EDIT, 10, 26, 226, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "确定", IDOK, 130, 56, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 186, 56, 50, 14
END
